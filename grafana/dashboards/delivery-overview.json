            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Container restarts (changes in start time, 15m)",
      "description": "Rises after a bad deploy that crash-loops",
      "datasource": {
